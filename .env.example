# ─────────────────────────────────────────────────────────────
# .env.example — Safe template — commit this to git
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────

# Google Earth Engine project ID (required for GEE scripts)
EE_PROJECT=your-gee-project-id-here

# ── Open-Meteo (free, no API key needed) ─────────────────────
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ── Nominatim / OpenStreetMap (free, no API key needed) ──────
# Change NOMINATIM_USER_AGENT to identify your own deployment
NOMINATIM_USER_AGENT=your-app-name/1.0 (your@email.com)
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse

# Web server settings (optional — defaults shown)
PORT=8000
